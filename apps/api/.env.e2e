# E2E suites must never create real eService sandbox links or refunds.
ESERVICE_APP_ID=
ESERVICE_APP_KEY=
ESERVICE_ACCOUNT_NAME=

# Destructive E2E resets must never point at the developer/certification DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_e2e?schema=public
REDIS_URL=redis://localhost:6379/15

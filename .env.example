# --------------------------------------------------------------------------
# Restaurant Ordering Platform — root .env (copy to .env for local dev)
# Every var is Zod-validated in packages/config-runtime + each app's env.ts
# --------------------------------------------------------------------------

# General
NODE_ENV=development

# --- Database / Cache ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant?schema=public
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-please-use-64-bytes
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-please-use-64-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Email (Resend in prod, mailhog in dev) ---
RESEND_API_KEY=
MAIL_FROM="Restaurant <no-reply@restaurant.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# --- SMS (Twilio in prod, console adapter in dev) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp owner alerts via Twilio. Sandbox sender is whatsapp:+14155238886;
# in prod use an approved WhatsApp Business sender. Empty → console fallback.
TWILIO_WHATSAPP_FROM=

# --- Owner / staff new-order alerts ---
# Web Push (VAPID) for the admin PWA. Generate once:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key in apps/admin's NEXT_PUBLIC_VAPID_PUBLIC_KEY too.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@restaurant.local
# Fallback owner recipients (comma-separated E.164) used until the Restaurant
# row's alert phone lists are configured. e.g. +48600100200,+48600100201
ORDER_ALERT_SMS_TO=
ORDER_ALERT_WHATSAPP_TO=

# --- Stripe (Sprint 4) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (local disk; in prod a Docker volume) ---
UPLOADS_DIR=uploads

# --- App URLs ---
APP_URL_WEB=http://localhost:3000
APP_URL_ADMIN=http://localhost:3001
APP_URL_API=http://localhost:4000
APP_DEEP_LINK_SCHEME=restaurant

# --- API ---
API_PORT=4000

# --- Frontend public env ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

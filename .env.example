# --------------------------------------------------------------------------
# Restaurant Ordering Platform — root .env (copy to .env for local dev)
# Every var is Zod-validated in packages/config-runtime + each app's env.ts
# --------------------------------------------------------------------------

# General
NODE_ENV=development

# --- Database / Cache ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant?schema=public
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-please-use-64-bytes
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-please-use-64-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Email (Resend in prod, mailhog in dev) ---
RESEND_API_KEY=
MAIL_FROM="Restaurant <no-reply@restaurant.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# --- SMS (Twilio in prod, console adapter in dev) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Admin PWA Web Push ---
# Generate once with: pnpm --filter @repo/api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@restaurant.local

# --- eService (Global Payments) online payments ---
# An empty ESERVICE_APP_ID runs the deterministic dev stub provider (no real
# eService account needed). Configure these to enable card + BLIK payments.
ESERVICE_ENV=sandbox
ESERVICE_APP_ID=
ESERVICE_APP_KEY=
ESERVICE_ACCOUNT_NAME=
# Public base URLs eService calls back to: API host (status_url webhook) + web host (return_url).
ESERVICE_WEBHOOK_URL=
ESERVICE_RETURN_URL=

# --- Order tracking ---
# HMAC secret for the signed guest order-tracking token (used in the
# X-Order-Token header for guest payments and in tracking deep links).
# Falls back to JWT_ACCESS_SECRET in non-prod; set explicitly in production.
ORDER_TRACKING_SECRET=

# --- Object storage (local disk; in prod a bind-mounted Docker volume at
#     /opt/restaurant/uploads → /var/uploads) ---
UPLOADS_DIR=uploads

# --- App URLs ---
APP_URL_WEB=http://localhost:3000
APP_URL_ADMIN=http://localhost:3001
APP_URL_API=http://localhost:4000

# --- API ---
API_PORT=4000

# --- Frontend public env ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

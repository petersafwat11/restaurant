{
	"name": "restaurant-app",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"db:migrate": "pnpm --filter @repo/db migrate:dev",
		"db:migrate:deploy": "pnpm --filter @repo/db migrate:deploy",
		"db:generate": "pnpm --filter @repo/db generate",
		"db:seed": "pnpm --filter @repo/db seed",
		"db:studio": "pnpm --filter @repo/db studio",
		"clean": "turbo run clean && rimraf node_modules"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"rimraf": "6.0.1",
		"turbo": "2.3.3",
		"typescript": "5.6.3"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "19.3.0",
			"@types/react-dom": "19.3.0",
			"axios@1": "1.21.1",
			"brace-expansion@2": "2.1.8",
			"engine.io@6": "6.6.11",
			"fast-uri@3": "3.1.9",
			"follow-redirects@1": "1.16.3",
			"form-data@4": "4.0.6",
			"js-cookie@3": "3.0.8",
			"socket.io-parser@4": "4.2.7",
			"source-map-js@1": "1.2.2",
			"ws@8": "8.22.2",
			"@fastify/busboy@3": "3.2.5"
		}
	}
}
